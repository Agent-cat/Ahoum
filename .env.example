# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sessions_market
HTTP_PORT=80

# Django
DJANGO_SECRET_KEY=change-me-to-something-random
DJANGO_DEBUG=1

# GitHub OAuth application (https://github.com/settings/developers)
# Homepage URL:            http://localhost/
# Authorization callback:  http://localhost/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Set to 1 to enable the dev-only username login (no GitHub credentials needed).
# Keep 0 in production.
DEV_LOGIN_ENABLED=1
